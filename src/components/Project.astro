---
interface Props {
  title: string;
  url?: string;
  made?: string;
  desc: string;
}

const { title, url, desc, made } = Astro.props;
---

<style>
  .wrapper {
    margin-top: 2.25rem;
  }

  header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    column-gap: 1.5rem;
  }

  h3 {
    position: relative;
    margin: 0;
    font-size: 1.2rem;
    line-height: 1.4;
  }

  /* A small four-pointed star in the margin */
  h3::before {
    content: "";
    position: absolute;
    left: -1.15rem;
    top: 50%;
    translate: 0 -50%;
    width: 0.75rem;
    height: 0.75rem;
    background: var(--accent, currentColor);
    mask: url("/star.svg") center / contain no-repeat;
  }

  h3 a {
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .made {
    font-style: italic;
    font-size: 0.85rem;
    color: var(--footnotes-border-color);
  }

  p {
    margin-top: 0.25rem;
  }

  .body {
    margin-top: 0.5rem;
    text-align: justify;
    hyphens: auto;
  }

  @media only screen and (max-width: 600px) {
    .body {
      text-align: left;
    }
  }
</style>

<div class="wrapper">
  <header>
    <h3>{url ? <a href={url}>{title}</a> : title}</h3>
    {made && <span class="made">{made}</span>}
  </header>
  <p>{desc}</p>
  {Astro.slots.has("default") && (
    <div class="body">
      <slot />
    </div>
  )}
</div>
