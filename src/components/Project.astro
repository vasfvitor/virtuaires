---
interface Props {
  title: string;
  url?: string;
  made?: string;
  /** Plain description; use the "desc" slot instead when it needs markup */
  desc?: string;
}

const { title, url, desc, made } = Astro.props;
---

<style>
  .wrapper {
    margin-top: 2.25rem;
  }

  header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    column-gap: 1.5rem;
  }

  h3 {
    position: relative;
    margin: 0;
    font-size: 1.2rem;
    line-height: 1.4;
  }

  /* A four-pointed star sitting off the corner of the title, behind it */
  h3::before {
    content: "";
    position: absolute;
    z-index: -1;
    left: -0.85rem;
    top: -0.45rem;
    width: 1.3rem;
    height: 1.3rem;
    rotate: 14deg;
    background: var(--accent, currentColor);
    opacity: 0.3;
    mask: url("/star.svg") center / contain no-repeat;
  }

  h3 a {
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .made {
    font-style: italic;
    font-size: 0.85rem;
    color: var(--muted);
  }

  p {
    margin-top: 0.25rem;
  }

  .body {
    margin-top: 0.5rem;
    text-wrap: pretty;
  }
</style>

<div class="wrapper">
  <header>
    <h3>{url ? <a href={url}>{title}</a> : title}</h3>
    {made && <span class="made">{made}</span>}
  </header>
  <p>
    <slot name="desc">{desc}</slot>
  </p>
  {Astro.slots.has("default") && (
    <div class="body">
      <slot />
    </div>
  )}
</div>
