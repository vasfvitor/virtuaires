---
import { skyAngle } from "../lib/sky";
---

<!-- The real sky, as of the build; the script below brings it up to date -->
<div
  class="sky"
  aria-hidden="true"
  style={`rotate: ${skyAngle(new Date())}deg`}
></div>

<style>
  /* Real star positions, see src/pages/sky.svg.ts */
  .sky {
    position: fixed;
    z-index: -30;
    left: 50%;
    top: 50%;
    width: 150vmax;
    height: 150vmax;
    translate: -50% -50%;
    background: url("/sky.svg") center / 100% 100% no-repeat;
    pointer-events: none;
    /* The script turns it every few seconds: keep that off the main thread */
    will-change: rotate;
    animation: reveal 1618ms ease-out both;
  }

  @media print {
    .sky {
      display: none;
    }
  }
</style>

<script>
  import { skyAngle } from "../lib/sky";

  const sky = document.querySelector<HTMLElement>(".sky")!;
  const turn = () => {
    sky.style.rotate = `${skyAngle(new Date())}deg`;
  };

  turn();
  // The sky turns a quarter of a degree per minute
  if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
    setInterval(turn, 5000);
  }
</script>
