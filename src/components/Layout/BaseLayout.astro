---
import BaseHead from "@components/Layout/BaseHead.astro";
import Footer from "@components/Layout/Footer.astro";

const { SITE_TITLE, SITE_DESCRIPTION, ...head } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} {...head} />
    <slot name="head" />
  </head>
  <body>
    <slot />
    <Footer />
  </body>
</html>
