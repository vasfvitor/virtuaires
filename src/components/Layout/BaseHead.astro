---
// Imported here so that every page gets the base styles
import "~/styles/base.css";

interface Props {
  title: string;
  description: string;
  image?: string;
  /** Keeps the page out of search results */
  noindex?: boolean;
  /** Open Graph type: the home page is a profile */
  type?: "website" | "profile";
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const {
  title,
  description,
  image = "/og.jpg",
  noindex = false,
  type = "website",
} = Astro.props;
const imageAlt = "A total solar eclipse over a field of stars";
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="theme-color" content="#0b111e" />
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
{
  /* The faces used at the top of the page, fetched before the text needs them */
  ["regular", "italic", "bold"].map((face) => (
    <link
      rel="preload"
      href={`/fonts/STIXTwoText-${face}.woff2`}
      as="font"
      type="font/woff2"
      crossorigin
    />
  ))
}
<meta name="generator" content={Astro.generator} />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />
<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="author" content="Vitor Ayres" />
<meta
  name="robots"
  content={noindex ? "noindex" : "index, follow, max-image-preview:large"}
/>

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content="Vitor Ayres" />
<meta property="og:locale" content="en_US" />
{type === "profile" && (
  <>
    <meta property="profile:first_name" content="Vitor" />
    <meta property="profile:last_name" content="Ayres" />
    <meta property="profile:username" content="vasfvitor" />
  </>
)}
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.url)} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={Astro.url} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={new URL(image, Astro.url)} />
<meta name="twitter:image:alt" content={imageAlt} />

<!-- Analytics, only on the published domains -->
<script
  is:inline
  defer
  src="https://cloud.umami.is/script.js"
  data-website-id="c2bbae60-f170-4d13-a7e0-43fc4b149ab7"
  data-domains="eu.virtuaires.com.br,virtuaires.com.br,www.virtuaires.com.br"
></script>

<script>
  import { litFromLeft, litPath, moonPhase } from "../../lib/sky";

  // The tab icon shows the Moon in its current phase
  const phase = moonPhase(new Date());
  const flip = litFromLeft(phase) ? " scale(-1 1)" : "";
  const icon = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="-16 -16 32 32"><circle r="16" fill="#0b111e"/><circle r="12.5" fill="#dfe9f8" fill-opacity=".13"/><path fill="#e6eefb" transform="scale(12.5)${flip}" d="${litPath(phase)}"/></svg>`;
  document
    .querySelector('link[rel="icon"][type="image/svg+xml"]')
    ?.setAttribute("href", `data:image/svg+xml,${encodeURIComponent(icon)}`);
</script>
