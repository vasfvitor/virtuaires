---
// Imported here so that every page gets the base styles
import "~/styles/base.css";
import { GROUND, SITE_TITLE } from "~/consts";

interface Props {
  title: string;
  description: string;
  /** Font files to fetch early: the faces used at the top of the page */
  fonts?: string[];
  /** Keeps the page out of search results */
  noindex?: boolean;
  /** Open Graph type: the home page is a profile */
  type?: "website" | "profile";
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const image = new URL("/og.jpg", Astro.url);

const {
  title,
  description,
  fonts = ["STIXTwoText-regular", "STIXTwoText-bold"],
  noindex = false,
  type = "website",
} = Astro.props;
const imageAlt = "A total solar eclipse over a field of stars";
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="theme-color" content={GROUND} />
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
{fonts.map((font) => (
  <link
    rel="preload"
    href={`/fonts/${font}.woff2`}
    as="font"
    type="font/woff2"
    crossorigin
  />
))}
<meta name="generator" content={Astro.generator} />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />
<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="author" content={SITE_TITLE} />
<meta
  name="robots"
  content={noindex ? "noindex" : "index, follow, max-image-preview:large"}
/>

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content="en_US" />
{type === "profile" && (
  <>
    <meta property="profile:first_name" content="Vitor" />
    <meta property="profile:last_name" content="Ayres" />
    <meta property="profile:username" content="vasfvitor" />
  </>
)}
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={Astro.url} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content={imageAlt} />

<!-- Analytics, only on the published domains -->
<script
  is:inline
  defer
  src="https://cloud.umami.is/script.js"
  data-website-id="c2bbae60-f170-4d13-a7e0-43fc4b149ab7"
  data-domains="eu.virtuaires.com.br,virtuaires.com.br,www.virtuaires.com.br"
  data-tag="eu"
></script>

<script>
  import { moonIcon, moonPhase } from "../../lib/sky";

  // The tab icon shows the Moon in its current phase
  const icon = moonIcon(moonPhase(new Date()));
  document
    .querySelector('link[rel="icon"][type="image/svg+xml"]')
    ?.setAttribute("href", `data:image/svg+xml,${encodeURIComponent(icon)}`);
</script>
