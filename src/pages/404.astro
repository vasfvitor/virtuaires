---
import BaseLayout from "@components/Layout/BaseLayout.astro";
import Sky from "@components/Sky.astro";
---

<BaseLayout
  title="Page not found"
  description="This page does not exist."
  noindex
>
  <Sky />
  <main>
    <h1>404</h1>
    <p>This star isn't in the catalogue.</p>
    <p>
      <a href="/">Go to the home page</a>
    </p>
  </main>
</BaseLayout>

<style>
  main {
    margin-top: 22vh;
    padding-block: 2rem;
    text-align: center;
  }

  h1 {
    font-size: 4rem;
    line-height: 1;
  }
</style>
