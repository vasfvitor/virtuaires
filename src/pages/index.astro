---
import { SITE_TITLE, SITE_DESCRIPTION } from "~/consts";
import BaseLayout from "@components/Layout/BaseLayout.astro";
import Image from "@components/Image.astro";

import ea from "/src/assets/projects/ea-demo.jpg";
import profile from "/src/assets/images/pfp.jpg";

import Project from "@components/Project.astro";

import Vitor from "/Vitor.svg?raw";
import stars from "../data/stars.json";
import { litFromLeft, litPath, moonPhase, skyAngle } from "../lib/sky";

import "../styles/animations.css";
import "../styles/index.css";

// Lets the signature be drawn with a single normalized dash
const signature = Vitor.replace("<path", '<path pathLength="1"');

// The sky and the Moon as of the build; the script below brings them up to date
const now = new Date();
const phase = moonPhase(now);

const lead = [
  ["Write,", "improve,", "fix"],
  ["&", "document", "code"],
];
---

<BaseLayout {SITE_TITLE} {SITE_DESCRIPTION}>
  <div
    class="sky"
    aria-hidden="true"
    style={`rotate: ${skyAngle(now)}deg`}
  ></div>
  <header class="hero">
    <div style="z-index: 60">
      <h1 class="sr-only">Vitor Ayres</h1>
      <div class="signature" set:html={signature} />
      <h2 class="lead">
        {lead.map((line, l) => (
          <>
            {line.map((word, w) => (
              <>
                <span style={`--i: ${l * 3 + w}`}>{word}</span>{" "}
              </>
            ))}
            {l === 0 && <br />}
          </>
        ))}
      </h2>
    </div>
    <div class="circle circle-first">
      <svg class="phase" viewBox="-1 -1 2 2" aria-hidden="true">
        <path
          d={litPath(phase)}
          transform={litFromLeft(phase) ? "scale(-1 1)" : undefined}
        ></path>
      </svg>
      <div class="circle circle-second">
        <div class="circle circle-final"></div>
      </div>
    </div>
  </header>
  <main class="reveal">
    <section class="about-me">
      <h2>About me</h2>
      <Image
        class="pfp"
        src={profile}
        alt="Vitor Ayres artistic profile - made by a real person"
      />
      <p>
        I enjoy solving puzzles and problems. It started with high school math
        and turned into code when a job needed a solution I had to program
        myself. These days most of my open source time goes into documentation:
        getting it correct, easy to find and easy to keep up to date.
      </p>
    </section>
    <section class="projects">
      <h2>Open source</h2>
      <Project
        title="Tauri documentation"
        desc="The docs behind tauri.app. Contributing since 2023, with 100+ merged pull requests and 240+ reviewed."
        url="https://github.com/tauri-apps/tauri-docs"
        made="Astro, Starlight and TypeScript"
      >
        Besides writing and fixing guides, I look after the site itself: the
        releases pages with inline changelogs, the translation workflow, link
        checking and dependency upkeep.
      </Project>
      <Project
        title="Tauri"
        desc="Fixes and docs tooling in the core repository and the plugins workspace."
        url="https://github.com/tauri-apps/tauri"
        made="Rust"
      >
        Among them, generating the Markdown permission tables used in the plugin
        reference.
      </Project>
      <Project
        title="Starlight"
        desc="Brazilian Portuguese translation of the Starlight documentation."
        url="https://github.com/withastro/starlight"
        made="Astro and MDX"
      />
      <Project
        title="astro-embed"
        desc="Contributed the Link Preview and GitHub Gist embeds."
        url="https://github.com/delucis/astro-embed"
        made="Astro and TypeScript"
      />
    </section>
    <section class="projects">
      <h2>Projects</h2>
      <Project
        title="nanci"
        desc="Desktop manager for Brazilian electronic invoices on Windows. It handles NFS-e through the official API with an A1 certificate, reads NF-e and CT-e, and keeps everything local."
        url="https://vasfvitor.github.io/nanci/"
        made="Go"
      />
      <Project
        title="buladiff"
        desc="Shows what changed between versions of the drug leaflets published in ANVISA's Bulário Eletrônico."
        url="https://vasfvitor.github.io/buladiff/"
        made="Python"
      />
      <Project
        title="mercos-sdk"
        desc="TypeScript SDK for the Mercos integration API."
        url="https://github.com/vasfvitor/mercos-sdk"
        made="TypeScript"
      />
      <br />
      <p>
        More on <a href="https://github.com/vasfvitor/">GitHub</a>.
      </p>
    </section>
    <section class="projects">
      <h2>Earlier work</h2>
      <Project
        title="Custom MT5 Expert Advisor"
        desc="MetaTrader 5 Expert Advisor - EA, made according to client's personal strategy and definitions. Closed Source."
        made="MQL5 (MetaQuotes Language 5), a C++ syntax language with OOP"
      >
        <Image src={ea} alt="Demo from the EA" />
        This was actually a challenge since I had to learn the basics of day
        trading to be able to understand and translate the strategy to code. I'm
        grateful for all the support folks at MQL5 forum provided.
      </Project>
    </section>
    <section>
      <h2>Get in touch</h2>
      <a href="mailto:vasfvitor@virtuaires.com.br">Send an email</a> or reach me
      on <a href="https://www.linkedin.com/in/ayresvitor/">LinkedIn</a>.
    </section>
    <p class="colophon">
      The sky behind this page is drawn from real data: the{" "}
      {stars.length.toLocaleString("en")} stars visible to the naked eye south
      of +40° declination, each placed by its coordinates, sized by its
      brightness and tinted by its temperature. The faint glow is the Milky Way.
      The view is centred on the south celestial pole and turned to match the
      sky right now on Brasília time, and the disc behind my name shows today's
      phase of the Moon as seen from the southern hemisphere. Data from the
      Hipparcos catalogue, via{" "}
      <a href="https://github.com/ofrohn/d3-celestial">d3-celestial</a>.
    </p>
  </main>
</BaseLayout>

<script>
  import { litFromLeft, litPath, moonPhase, skyAngle } from "../lib/sky";

  const sky = document.querySelector<HTMLElement>(".sky")!;
  const lit = document.querySelector(".phase path")!;

  const update = () => {
    const now = new Date();
    const phase = moonPhase(now);
    sky.style.rotate = `${skyAngle(now)}deg`;
    lit.setAttribute("d", litPath(phase));
    lit.setAttribute("transform", litFromLeft(phase) ? "scale(-1 1)" : "");
  };

  update();
  // The sky turns a quarter of a degree per minute
  if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
    setInterval(update, 5000);
  }
</script>
