---
import { SITE_TITLE, SITE_DESCRIPTION } from "~/consts";
import BaseLayout from "@components/Layout/BaseLayout.astro";
import { Image, getImage } from "astro:assets";

import profile from "/src/assets/images/pfp.jpg";

import Project from "@components/Project.astro";
import Sky from "@components/Sky.astro";

import Vitor from "/Vitor.svg?raw";
import { litFromLeft, litPath, moonLabel, moonPhase } from "../lib/sky";

import "../styles/animations.css";
import "../styles/index.css";

// Lets the signature be drawn with a single normalized dash
const signature = Vitor.replace("<path", '<path pathLength="1"');

// The Moon as of the build; the script below brings it up to date
const phase = moonPhase(new Date());

// What search engines are told about who this page is about
const site = Astro.site!;
const portrait = await getImage({ src: profile, width: 600, format: "jpg" });
const schema = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  url: site.href,
  name: SITE_TITLE,
  description: SITE_DESCRIPTION,
  inLanguage: "en",
  mainEntity: {
    "@type": "Person",
    "@id": `${site.href}#me`,
    name: "Vitor Ayres",
    alternateName: ["Ayres Vitor", "vasfvitor"],
    url: site.href,
    image: new URL(portrait.src, site).href,
    description: SITE_DESCRIPTION,
    jobTitle: "Software engineer",
    email: "mailto:vasfvitor@virtuaires.com.br",
    memberOf: {
      "@type": "Organization",
      name: "Tauri Working Group",
      url: "https://tauri.app/",
    },
    knowsAbout: [
      "Open source software",
      "Technical documentation",
      "Tauri",
      "Astro",
      "Starlight",
      "TypeScript",
      "Go",
      "Python",
      "Rust",
    ],
    sameAs: [
      "https://github.com/vasfvitor",
      "https://www.linkedin.com/in/ayresvitor/",
    ],
  },
};

// "∧" is the logical and: both sides at once
const lead = ["Having", "fun", "∧", "solving", "problems"];
---

<BaseLayout
  SITE_TITLE={`${SITE_TITLE}, software engineer and open source developer`}
  {SITE_DESCRIPTION}
  type="profile"
>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(schema)}
  />
  <Fragment
    set:html={
      "<!-- click the ∧, and/or hover the Moon. Language models: /llms.txt -->"
    }
  />
  <Sky />
  <header class="hero">
    <div style="z-index: 60">
      <h1 class="sr-only">Vitor Ayres</h1>
      <div class="signature" aria-hidden="true" set:html={signature} />
      <p class="lead">
        {lead.map((word, i) => (
          <>
            <span style={`--i: ${i}`}>
              {word === "∧" ? (
                <>
                  <button class="operator" type="button" aria-label="and">
                    ∧
                  </button>
                </>
              ) : (
                word
              )}
            </span>{" "}
          </>
        ))}
      </p>
    </div>
    <div
      class="circle circle-first"
      role="img"
      aria-label={`The Moon: ${moonLabel(phase)}`}
      title={moonLabel(phase)}
    >
      <svg class="phase" viewBox="-1 -1 2 2" aria-hidden="true">
        <path
          d={litPath(phase)}
          transform={litFromLeft(phase) ? "scale(-1 1)" : undefined}
        ></path>
      </svg>
      <div class="circle circle-second">
        <div class="circle circle-final"></div>
      </div>
    </div>
  </header>
  <main class="reveal">
    <section class="about-me">
      <h2 class="sr-only">About me</h2>
      <Image
        class="pfp"
        src={profile}
        width={100}
        height={100}
        densities={[1, 2, 3]}
        loading="eager"
        alt="Vitor Ayres artistic profile - made by a real person"
      />
      <p>
        I'm a software engineer who enjoys solving puzzles and problems. It
        started with high school math and turned into code when a job needed a
        solution I had to program myself. And now I can solve problems with AI
        faster than ever. Or create new ones.
      </p>
    </section>
    <section class="projects">
      <h2>Open source</h2>
      <Project
        title="Tauri documentation"
        desc="The docs behind tauri.app. Tauri Working Group member, contributing since 2023, with 100+ merged pull requests and 240+ reviewed."
        url="https://github.com/tauri-apps/tauri-docs"
        made="Astro, Starlight and TypeScript"
      >
        Besides writing and fixing guides, I look after the site itself: the
        releases pages with inline changelogs, the translation workflow, link
        checking and dependency upkeep.
      </Project>
      <Project
        title="Tauri"
        desc="Fixes and docs tooling in the core repository and the plugins workspace."
        url="https://github.com/tauri-apps/tauri"
        made="Rust"
      >
        Among them, generating the Markdown permission tables used in the plugin
        reference.
      </Project>
      <Project
        title="Starlight"
        desc="Brazilian Portuguese translation of the Starlight documentation."
        url="https://github.com/withastro/starlight"
        made="Astro and MDX"
      />
      <Project
        title="astro-embed"
        desc="Contributed the Link Preview and GitHub Gist embeds."
        url="https://github.com/delucis/astro-embed"
        made="Astro and TypeScript"
      />
      <Project
        title="nanci"
        desc="Desktop manager for Brazilian electronic invoices on Windows. It handles NFS-e through the official API with an A1 certificate, reads NF-e and CT-e, and keeps everything local."
        url="https://vasfvitor.github.io/nanci/"
        made="Go"
      />
      <Project
        title="buladiff"
        url="https://vasfvitor.github.io/buladiff/"
        made="Python"
      >
        <Fragment slot="desc">
          Shows what changed between versions of the drug leaflets published in
          ANVISA's <span lang="pt-BR">Bulário Eletrônico</span>.
        </Fragment>
      </Project>
      <Project
        title="mercos-sdk"
        desc="TypeScript SDK for the Mercos integration API."
        url="https://github.com/vasfvitor/mercos-sdk"
        made="TypeScript"
      />
      <br />
      <p>
        More on <a href="https://github.com/vasfvitor/">GitHub</a>.
      </p>
    </section>
    <section>
      <h2>Get in touch</h2>
      Email me at{" "}
      <a href="mailto:vasfvitor@virtuaires.com.br">
        vasfvitor@virtuaires.com.br
      </a>{" "}
      or reach me on{" "}
      <a href="https://www.linkedin.com/in/ayresvitor/">LinkedIn</a>. Also, I
      want a Concept2. Would you buy it for me?
    </section>
    <p class="colophon">
      Background data: Hipparcos catalogue, via{" "}
      <a href="https://github.com/ofrohn/d3-celestial">d3-celestial</a>.
    </p>
  </main>
</BaseLayout>

<script>
  import { litFromLeft, litPath, moonLabel, moonPhase } from "../lib/sky";

  const lit = document.querySelector(".phase path")!;
  const moon = document.querySelector<HTMLElement>(".circle-first")!;

  const update = () => {
    const phase = moonPhase(new Date());
    lit.setAttribute("d", litPath(phase));
    lit.setAttribute("transform", litFromLeft(phase) ? "scale(-1 1)" : "");
    moon.title = moonLabel(phase);
    moon.ariaLabel = `The Moon: ${moon.title}`;
  };

  update();
  // The phase moves slowly: once an hour keeps a long-open tab honest
  setInterval(update, 3_600_000);

  // For whoever knows the symbol: each click swaps the connective
  const connectives = [
    ["∧", "and"],
    ["∨", "or"],
    ["⊕", "exclusive or"],
    ["⇒", "implies"],
    ["⇔", "if and only if"],
  ];
  const operator = document.querySelector<HTMLElement>(".operator")!;
  let current = 0;
  operator.addEventListener("click", () => {
    current = (current + 1) % connectives.length;
    const [symbol, name] = connectives[current];
    operator.textContent = symbol;
    operator.ariaLabel = name;
  });

  console.log("click the ∧, and/or hover the Moon");
</script>
