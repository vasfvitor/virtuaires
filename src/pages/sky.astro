---
import BaseLayout from "@components/Layout/BaseLayout.astro";
import { SITE_TITLE } from "~/consts";
import milkyWay from "../data/milkyway.json";
import stars from "../data/stars.json";
import {
  moonLabel,
  moonPhase,
  skyAngle,
  skyFacts,
  type Star,
} from "../lib/sky";

const now = new Date();

/** What the page states about the sky right now, under two headings */
const facts = skyFacts(now, stars as Star[]);
const FACTS = [
  [
    "The Moon today",
    [
      ["phase", "Phase"],
      ["lit", "Illuminated"],
      ["age", "Age"],
      ["newMoon", "Next new Moon"],
      ["fullMoon", "Next full Moon"],
    ],
  ],
  [
    "Tonight from Brasília",
    [
      ["sun", "Sun"],
      ["stars", "Stars above the horizon"],
      ["named", "Named stars up"],
      ["next", "Next to cross the meridian"],
    ],
  ],
] as const;

const DESCRIPTION =
  "The southern sky over Brasília, live and played as music. Each star sounds as it crosses the meridian, in a scale set by tonight's Moon.";

// What search engines are told about this page
const site = Astro.site!;
const schema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  url: new URL("/sky/", site).href,
  name: "The southern sky",
  description: DESCRIPTION,
  inLanguage: "en",
  isPartOf: { "@type": "WebSite", url: site.href, name: SITE_TITLE },
  author: { "@id": `${site.href}#me` },
  about: [
    { "@type": "Thing", name: "Southern celestial hemisphere" },
    { "@type": "Thing", name: "Sonification" },
    { "@type": "Thing", name: "Lunar phase" },
  ],
};

/** The instruments: key, name, what plays it and starting level */
const BANDS = [
  ["bells", "Bells", "The 31 brightest stars. Each one sets the chord", 1],
  [
    "stars",
    "Tune",
    "A short phrase made from the stars at the start of each section",
    1,
  ],
  ["dust", "Dust", "All the other stars, on notes of the chord", 0.6],
  ["drums", "Pulse", "A kick on the beat. Faint stars play the hi-hat", 0.7],
  [
    "bass",
    "Bass",
    "Follows the chord, and brightens while the Milky Way crosses",
    0.5,
  ],
] as const;
/** The sound controls: key, label, lowest, highest, step and starting value */
const KNOBS = [
  ["volume", "Volume", 0, 1, 0.01, 0.7],
  ["echo", "Echo level", 0, 1, 0.01, 1],
  ["repeats", "Echo repeats", 0, 0.85, 0.01, 0.42],
  ["tone", "Echo brightness, Hz", 400, 8000, 50, 2200],
  ["length", "Note length", 0.3, 3, 0.05, 1],
  ["shimmer", "Overtone", 0, 1, 0.01, 0.25],
  // 180° less the golden angle
  ["line", "Second line, °", 10, 90, 0.5, 42.5],
] as const;
/** Starting points for the controls: each one only lists what it changes */
const PRESETS = {
  Night: {},
  Dry: { echo: 0, length: 0.7 },
  Cathedral: { tempo: 54, repeats: 0.7, tone: 1400, length: 1.6 },
  Glass: { shimmer: 0.8, tone: 6000, length: 0.6, repeats: 0.3 },
  "Bells only": { stars: 0, dust: 0, drums: 0, bass: 0 },
  Rain: { tempo: 132, length: 0.4, repeats: 0.25 },
};
/** One scale per stretch of the lunar month, from the full Moon's to the new Moon's */
const SCALES = [
  ["Lydian", [0, 2, 4, 6, 7, 9, 11]],
  ["Major", [0, 2, 4, 7, 9]],
  ["Suspended", [0, 2, 5, 7, 10]],
  ["Minor", [0, 3, 5, 7, 10]],
  ["Hirajoshi", [0, 2, 3, 7, 8]],
  ["Phrygian", [0, 1, 5, 7, 8]],
] as const;

/** How much of the Milky Way lies on the meridian at every other degree of sidereal time, 0 to 1 */
const glow = (() => {
  const flat = (ra: number, dec: number) => {
    const angle = (ra * Math.PI) / 180;
    return [(90 + dec) * Math.sin(angle), (90 + dec) * Math.cos(angle)];
  };
  // The brightness levels are nested: a point counts once for each it is in
  const levels = (milkyWay as [number, number][][][]).map((rings) =>
    rings.map((ring) => ring.map(([ra, dec]) => flat(ra, dec))),
  );
  const holds = (ring: number[][], x: number, y: number) => {
    let odd = false;
    for (let i = 0, j = ring.length - 1; i < ring.length; j = i++) {
      const [xi, yi] = ring[i];
      const [xj, yj] = ring[j];
      if (yi > y !== yj > y && x < ((xj - xi) * (y - yi)) / (yj - yi) + xi) {
        odd = !odd;
      }
    }
    return odd;
  };
  const totals = Array.from({ length: 180 }, (_, i) => {
    let total = 0;
    for (let dec = -85; dec <= 20; dec += 5) {
      const [x, y] = flat(i * 2, dec);
      for (const rings of levels) {
        total += rings.filter((ring) => holds(ring, x, y)).length % 2;
      }
    }
    return total;
  });
  const most = Math.max(...totals);
  return totals.map((total) => Number((total / most).toFixed(2)));
})();
---

<BaseLayout
  title="The southern sky"
  description={DESCRIPTION}
  fonts={["STIXTwoText-regular", "STIXTwoText-italic", "STIXTwoText-bold"]}
  image={{
    src: "/og-sky.jpg",
    alt: "The Southern Cross upright on the meridian line, with rings where Acrux and Gacrux sound",
  }}
>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(schema)}
  />
  <div
    class="chart"
    aria-hidden="true"
    style={`rotate: ${skyAngle(now)}deg`}
  ></div>
  <canvas
    class="stage"
    aria-hidden="true"
    data-glow={JSON.stringify(glow)}
  ></canvas>
  <main>
    <h1>The southern sky</h1>
    <button type="button" aria-pressed="false">
      Listen
    </button>
    <p class="readout">
      <span class="phase">{moonLabel(moonPhase(now))}</span>
      <br />
      <span class="star">&nbsp;</span>
    </p>
    <div class="mix">
      <label>
        <span>Tempo, bpm</span>
        <input
          type="range"
          name="tempo"
          min="30"
          max="200"
          step="1"
          value="72"
        />
        <output>72</output>
      </label>
      {BANDS.map(([key, name, source, value]) => (
        <div class="strip">
          <label title={source}>
            <span>{name}</span>
            <input
              type="range"
              name={key}
              min="0"
              max="1.5"
              step="0.01"
              {value}
              aria-label={`${name} level`}
            />
          </label>
          <canvas data-roll={key} aria-hidden="true" />
        </div>
      ))}
    </div>
    <details>
      <summary>Sound</summary>
      <div class="knobs">
        <label>
          <span>Preset</span>
          <select name="preset">
            {Object.entries(PRESETS).map(([name, values]) => (
              <option value={JSON.stringify(values)}>{name}</option>
            ))}
          </select>
        </label>
        {KNOBS.map(([key, label, min, max, step, value]) => (
          <label>
            <span>{label}</span>
            <input type="range" name={key} {min} {max} {step} {value} />
            <output>{value}</output>
          </label>
        ))}
        <label>
          <span>Scale</span>
          <select name="scale">
            <option value="">The Moon's</option>
            {SCALES.map(([name, notes]) => (
              <option value={notes.join(" ")}>{name}</option>
            ))}
          </select>
        </label>
      </div>
    </details>
    <section class="notes">
      <h2>How it plays</h2>
      <p>
        The sky keeps the time: one beat is one sidereal minute. Stars play as
        they cross the lines. The 31 brightest ring as bells and change the
        chord; the rest play the hi-hat and soft notes.
      </p>
      <p>
        The melody comes from the stars at the start of each section and
        repeats. The Moon picks the scale, and the Milky Way brightens the bass.
      </p>
      {FACTS.map(([heading, rows]) => (
        <>
          <h2>{heading}</h2>
          <dl>
            {rows.map(([key, label]) => (
              <div>
                <dt>{label}</dt>
                <dd data-fact={key}>{facts[key]}</dd>
              </div>
            ))}
          </dl>
        </>
      ))}
      <!-- For readers that do not run the script below, which keeps all of this current -->
      <p class="as-of">
        As of <span data-fact="asOf">{facts.asOf}</span>.
      </p>
    </section>
  </main>
</BaseLayout>

<style>
  /* Same chart as the home page, with the pole near the bottom of the window */
  .chart {
    position: fixed;
    z-index: -30;
    left: 50%;
    top: 86svh;
    width: max(210svh, 130vw);
    height: max(210svh, 130vw);
    translate: -50% -50%;
    background: url("/sky.svg") center / 100% 100% no-repeat;
    pointer-events: none;
    will-change: rotate;
    animation: reveal 1618ms ease-out both;
  }

  .stage {
    position: fixed;
    /* Above the text, so a name is never hidden behind the controls */
    z-index: 1;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  main {
    min-height: calc(100svh - 4rem);
    background: none;
    box-shadow: none;
    text-shadow:
      0 0 0.4em var(--ground),
      0 0 1em var(--ground);
  }

  h1 {
    font-size: 1.6rem;
    line-height: 1.3;
    margin-bottom: 0;
    text-align: left;
  }

  button {
    margin-top: 1rem;
    padding: 0.15rem 0.9rem;
    border: 1px solid var(--rule);
    border-radius: 2rem;
    background: color-mix(in srgb, var(--ground) 70%, transparent);
    color: var(--heading);
    cursor: pointer;
  }

  button:hover,
  button[aria-pressed="true"] {
    border-color: var(--accent);
  }

  button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* What the page is, for whoever scrolls this far */
  .notes {
    max-width: 30rem;
    margin-top: 4rem;
    font-size: 0.8rem;
    line-height: 1.6;
    color: var(--muted);
  }

  .notes h2 {
    margin: 1.5rem 0 0;
    font-size: 0.9rem;
    color: var(--text);
  }

  .notes p {
    margin-top: 0.4rem;
  }

  .notes dl {
    margin: 0.4rem 0 0;
  }

  .notes dl div {
    display: grid;
    grid-template-columns: 11rem 1fr;
    gap: 0.75rem;
  }

  .notes dd {
    margin: 0;
    color: var(--text);
  }

  /* On a phone the label goes above its value */
  @media (max-width: 600px) {
    .notes dl div {
      display: block;
      margin-top: 0.35rem;
    }
  }

  .readout {
    margin-top: 0.5rem;
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
    color: var(--muted);
  }

  details,
  .mix {
    max-width: 18rem;
    margin-top: 0.75rem;
    font-size: 0.8rem;
    color: var(--muted);
  }

  /* One strip per instrument: its level, and what it is about to play */
  .strip {
    margin-top: 0.3rem;
  }

  .strip label {
    grid-template-columns: 1fr 6rem;
  }

  .strip canvas {
    display: block;
    width: 100%;
    height: 2.1rem;
    border: 1px solid var(--rule);
    border-radius: 0.25rem;
    background: color-mix(in srgb, var(--ground) 75%, transparent);
  }

  summary {
    width: fit-content;
    cursor: pointer;
  }

  .knobs {
    display: grid;
    gap: 0.1rem;
    margin-top: 0.25rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--rule);
    border-radius: 0.5rem;
    background: color-mix(in srgb, var(--ground) 75%, transparent);
  }

  label {
    display: grid;
    grid-template-columns: 8.5rem 1fr 2.4rem;
    align-items: center;
    gap: 0.5rem;
  }

  input,
  select {
    min-width: 0;
    accent-color: var(--accent);
  }

  select {
    grid-column: span 2;
    font: inherit;
    color: var(--text);
    background: var(--ground);
    border: 1px solid var(--rule);
    border-radius: 0.25rem;
  }

  output {
    font-variant-numeric: tabular-nums;
    text-align: right;
  }

  @media print {
    .chart,
    .stage {
      display: none;
    }
  }
</style>

<script>
  // The catalogue in a file of its own, which stays cached when the code changes
  const { default: catalogue } = await import("../data/stars.json");
  import {
    COLORS,
    LIMIT,
    NAMED,
    TURN,
    UP,
    colorClass,
    litShare,
    moonLabel,
    moonPhase,
    siderealTime,
    skyFacts,
    wrap,
    type Star,
  } from "../lib/sky";

  /** The instruments, each with its own way into the mix */
  type Band = "bells" | "stars" | "dust" | "drums" | "bass";
  /** A line the stars play on: degrees west of the meridian, and how loud */
  type Line = { west: number; gain: number };
  /** A star reaching a line: a named one rings a bell, any other glints */
  type Hit = { star: Star; line: Line; band: "bells" | "dust" };

  /** Sorted by right ascension, the order in which the stars reach the line */
  const stars = [...(catalogue as Star[])].sort((a, b) => a[0] - b[0]);

  /** Degrees per second the real sky turns */
  const REAL = TURN / 86_400;
  /** Degrees of turn per beat: a quarter of a degree is one sidereal minute */
  const BEAT = 0.25;
  /** Everything sounds on a grid of sixteenth notes */
  const GRID = BEAT / 4;
  /** Sixteenths in a bar, and bars in a phrase */
  const BAR = 16;
  const PHRASE = 4;
  /** Seconds of sound scheduled ahead, so the rhythm does not depend on the frame rate */
  const AHEAD = 0.12;
  /** Faintest magnitude the tune is drawn from */
  const CLEAR = 4.5;
  /** Degrees across the whole chart */
  const SPAN = (90 + LIMIT) * 2;

  /** The colours drawn over the sky */
  const RULE = "rgb(157 180 255)";
  const PALE = "rgb(232 239 251)";
  const BASS = "rgb(102 199 255)";
  const TUNE = COLORS[1][1];

  const names = new Map<Star, string>();
  for (const [ra, dec, name] of NAMED) {
    const star = stars.find((star) => star[0] === ra && star[1] === dec);
    if (star) names.set(star, name);
  }

  /**
   * The Southern Cross always plays the same open fifths, in semitones above
   * A3 from its foot to its head, whatever scale the Moon has picked
   */
  const CROSS: Record<string, number> = {
    Acrux: 0,
    Mimosa: 7,
    Imai: 12,
    Gacrux: 19,
  };

  // The controls
  const main = document.querySelector("main")!;
  const picker = main.querySelector<HTMLSelectElement>("[name=scale]")!;
  const presets = main.querySelector<HTMLSelectElement>("[name=preset]")!;
  const knobs = Object.fromEntries(
    [...main.querySelectorAll<HTMLInputElement>("input[type=range]")].map(
      (input) => [input.name, input],
    ),
  );
  const knob = (name: string) => knobs[name].valueAsNumber;

  /** The scales on offer, brightest first; the Moon picks one by how much of it is lit */
  const scales = [...picker.options]
    .filter((option) => option.value)
    .map((option) => option.value.split(" ").map(Number));
  const moonScale =
    scales[
      Math.round((1 - litShare(moonPhase(new Date()))) * (scales.length - 1))
    ];
  const currentScale = () =>
    picker.value ? scales[picker.selectedIndex - 1] : moonScale;

  const chart = document.querySelector<HTMLElement>(".chart")!;
  const canvas = document.querySelector<HTMLCanvasElement>(".stage")!;
  const pen = canvas.getContext("2d")!;
  const button = document.querySelector<HTMLButtonElement>("main > button")!;
  const readout = document.querySelector<HTMLElement>(".star")!;
  // The page was built on another day: the Moon and tonight's sky are
  // brought up to date, and kept so
  const today = () => {
    const date = new Date();
    document.querySelector(".phase")!.textContent = moonLabel(moonPhase(date));
    const facts = skyFacts(
      date,
      stars,
      Intl.DateTimeFormat().resolvedOptions().timeZone,
    );
    for (const fact of document.querySelectorAll<HTMLElement>("[data-fact]")) {
      fact.textContent = facts[fact.dataset.fact as keyof typeof facts];
    }
  };
  today();
  document.querySelector<HTMLElement>(".as-of")!.hidden = true;
  setInterval(today, 60_000);
  const calm = matchMedia("(prefers-reduced-motion: reduce)").matches;
  /** How much of the Milky Way lies on the meridian at every other degree, 0 to 1 */
  const glow: number[] = JSON.parse(canvas.dataset.glow!);
  const glowAt = (sidereal: number) => glow[Math.floor(wrap(sidereal) / 2)];
  /** One small window per instrument, showing what it is about to play */
  const rolls = [
    ...main.querySelectorAll<HTMLCanvasElement>("[data-roll]"),
  ].map((sheet) => ({
    sheet,
    key: sheet.dataset.roll as Band,
    pen: sheet.getContext("2d")!,
    width: 0,
    height: 0,
  }));
  const stage = { sheet: canvas, pen, width: 0, height: 0 };

  /** What crosses the lines on each step of the grid, worked out once */
  const score = new Map<number, Hit[]>();
  /** The chord of each bar, and the tune of each pair of phrases, worked out once */
  const chords = new Map<number, number>();
  const tunes = new Map<number, Tune>();
  const forget = () => {
    score.clear();
    chords.clear();
    tunes.clear();
  };

  /**
   * The lines the stars play on: the meridian, and a second one the same
   * stars reach a little later, where they sound again more quietly
   */
  let lines: Line[] = [];
  const draft = () => {
    lines = [
      { west: 0, gain: 1 },
      { west: knob("line"), gain: 0.55 },
    ];
    forget();
  };

  // The lines run from the pole to the edge of the window
  let pole = { x: 0, y: 0 };
  let perDegree = 1;
  const measure = () => {
    const ratio = devicePixelRatio;
    for (const each of [stage, ...rolls]) {
      each.width = each.sheet.clientWidth;
      each.height = each.sheet.clientHeight;
      each.sheet.width = each.width * ratio;
      each.sheet.height = each.height * ratio;
      each.pen.setTransform(ratio, 0, 0, ratio, 0, 0);
    }
    // Measured on the chart itself: turning it does not move its centre
    const box = chart.getBoundingClientRect();
    pole = { x: box.x + box.width / 2, y: box.y + box.height / 2 };
    perDegree = chart.offsetWidth / SPAN;
    draft();
  };

  /** Where a point so many degrees from the pole along a line falls on screen */
  const along = (west: number, distance: number) => {
    const angle = (west * Math.PI) / 180;
    return {
      x: pole.x + distance * perDegree * Math.sin(angle),
      y: pole.y - distance * perDegree * Math.cos(angle),
    };
  };
  /** How many degrees from the pole a line runs before it leaves the window */
  const span = (west: number) => {
    const angle = (west * Math.PI) / 180;
    const side = (stage.width - pole.x) / Math.sin(angle);
    return (
      Math.min(pole.y / Math.cos(angle), west ? side : Infinity) / perDegree
    );
  };
  /**
   * How high a star crosses, from 0 at the pole to 1 at the edge of the
   * chart. It is measured on the sky, not the window, so a star sounds the
   * same note on every screen
   */
  const heightOf = (star: Star) => (90 + star[1]) / (90 + LIMIT);

  /** The stars whose right ascension lies between two sidereal times, up to a declination */
  const crossed = (from: number, to: number, limit: number) => {
    const found: Star[] = [];
    const [a, b] = [wrap(from), wrap(to)];
    const first = (ra: number) => {
      let [i, j] = [0, stars.length];
      while (i < j) {
        const mid = (i + j) >> 1;
        if (stars[mid][0] <= ra) i = mid + 1;
        else j = mid;
      }
      return i;
    };
    const take = (start: number, end: number) => {
      for (let i = first(start); i < stars.length && stars[i][0] <= end; i++) {
        if (stars[i][1] <= limit) found.push(stars[i]);
      }
    };
    if (a <= b) take(a, b);
    else {
      take(a, 360);
      take(-1, b);
    }
    return found;
  };

  /**
   * The stars that reach a line during one step: the brightest of the
   * unnamed ones, and, on a beat, every named star that crossed since the
   * last one. A bell between beats would sound out of time
   */
  const hitsAt = (step: number) => {
    const known = score.get(step);
    if (known) return known;
    const hits: Hit[] = [];
    for (const line of lines) {
      const limit = span(line.west) - 90;
      const since = (steps: number) =>
        crossed(
          (step - steps) * GRID - line.west,
          step * GRID - line.west,
          limit,
        );
      if (wrap(step, 4) === 0) {
        for (const star of since(4).filter((star) => names.has(star))) {
          hits.push({ star, line, band: "bells" });
        }
      }
      const found = since(1).sort((a, b) => a[2] - b[2]);
      const glint = found.find((star) => !names.has(star));
      if (glint) hits.push({ star: glint, line, band: "dust" });
    }
    if (score.size > 600) score.clear();
    score.set(step, hits);
    return hits;
  };

  // Harmony. The phrases go round a familiar progression, so the ear can
  // settle into it; a bell is the surprise, moving its bar's chord to its note

  /** Semitones above A of a degree of the scale, counting on through the octaves */
  const semitones = (degree: number) => {
    const scale = currentScale();
    return (
      12 * Math.floor(degree / scale.length) + scale[wrap(degree, scale.length)]
    );
  };
  /** Semitones above A, within one octave */
  const pitchClass = (degree: number) => wrap(semitones(degree), 12);

  /** The degree a bell's star puts the chord on */
  const bellDegree = (star: Star) => {
    const scale = currentScale();
    const interval = CROSS[names.get(star) ?? ""];
    return interval === undefined
      ? Math.floor(heightOf(star) * scale.length * 2) % scale.length
      : Math.max(0, scale.indexOf(interval % 12));
  };

  // Form. Listening starts a song: an intro with only the pad and bass, then
  // verses and choruses that add the tune and the pulse, and a break where
  // only the bells ring; after the break it goes round again from the verse

  /** Bars a section lasts: two phrases */
  const VERSE = BAR * PHRASE * 2;
  /** What plays in each section: the tune (off, or up an octave for a chorus), the pulse (off, kick, kick and hi-hat) and the bass */
  const SONG = [
    { name: "Intro", tune: 0, pulse: 0, bass: true },
    { name: "Verse", tune: 1, pulse: 1, bass: true },
    { name: "Verse", tune: 1, pulse: 2, bass: true },
    { name: "Chorus", tune: 2, pulse: 2, bass: true },
    { name: "Verse", tune: 1, pulse: 2, bass: true },
    { name: "Chorus", tune: 2, pulse: 2, bass: true },
    { name: "Break", tune: 0, pulse: 0, bass: false },
  ];
  /** The step the song started on, at a bar line */
  let origin = 0;
  /** Which section of the song a step is in, counted from its start */
  const partOf = (step: number) => {
    const n = Math.floor((step - origin) / VERSE);
    return n < 1 ? 0 : 1 + ((n - 1) % (SONG.length - 1));
  };
  const sectionAt = (step: number) => SONG[partOf(step)];
  /** Which bar of its phrase a step is in */
  const barOf = (step: number) =>
    wrap(Math.floor((step - origin) / BAR), PHRASE);

  /** The chord of the bar a step is in, as the degree of the scale it stands on */
  const chordAt = (step: number) => {
    const bar = Math.floor(step / BAR);
    const known = chords.get(bar);
    if (known !== undefined) return known;
    // I V vi IV, or the same moves on a five-note scale
    const round = currentScale().length > 5 ? [0, 4, 5, 3] : [0, 3, 4, 2];
    let chord = round[barOf(step)];
    for (let i = 0; i < BAR; i++) {
      const bell = hitsAt(bar * BAR + i).find(
        (hit) => hit.band === "bells" && !hit.line.west,
      );
      if (bell) chord = bellDegree(bell.star);
    }
    if (chords.size > 200) chords.clear();
    chords.set(bar, chord);
    return chord;
  };
  /** The notes of a chord: every other note of the scale from its root */
  const chordTones = (degree: number) => [degree, degree + 2, degree + 4];

  // The tune. What sticks in the ear repeats, keeps to common rhythms and
  // small steps with one leap, and rises before it falls

  /** Rhythms a tune can take, as sixteenths into the bar, from plain to lightly syncopated */
  const RHYTHMS = [
    [0, 4, 8, 10, 12],
    [0, 3, 6, 8, 12],
    [0, 2, 4, 8, 12, 14],
    [0, 6, 8, 12],
    [0, 4, 6, 8, 11],
  ];
  /** A one-bar motif: when its notes fall, and how far each is from the first, in degrees */
  type Tune = { rhythm: number[]; shape: number[] };

  /**
   * The motif, drawn from the stars that cross as its section begins. How
   * many cross in its first two bars picks its rhythm, and the heights of the
   * next few its shape: each star higher or lower than the last moves it a
   * step, nearly level ones repeat a note, and the biggest jump among them
   * becomes its one leap. Every chorus of a round sings the same one
   */
  const tuneAt = (step: number) => {
    let part = Math.floor((step - origin) / VERSE);
    if (sectionAt(step).name === "Chorus") {
      const round = SONG.length - 1;
      const first = SONG.findIndex((section) => section.name === "Chorus");
      part = Math.floor((part - 1) / round) * round + first;
    }
    const known = tunes.get(part);
    if (known) return known;
    const from = (origin + part * VERSE) * GRID;
    const clear = (found: Star[]) => found.filter((star) => star[2] <= CLEAR);
    const rhythm =
      RHYTHMS[
        clear(crossed(from, from + 2 * BAR * GRID, LIMIT)).length %
          RHYTHMS.length
      ];
    const heights = clear(crossed(from, from + 30, LIMIT))
      .slice(0, rhythm.length)
      .map(heightOf);
    const jumps = rhythm.map((_, i) =>
      i && i < heights.length ? heights[i] - heights[i - 1] : 0,
    );
    const widest = jumps.reduce(
      (best, jump, i) => (Math.abs(jump) > Math.abs(jumps[best]) ? i : best),
      0,
    );
    let degree = 0;
    const shape = jumps.map((jump, i) => {
      const size = Math.abs(jump);
      const move =
        size < 0.04
          ? 0
          : Math.sign(jump) *
            (i === widest && size > 0.3 ? 3 : size > 0.2 ? 2 : 1);
      return (degree = Math.max(-3, Math.min(5, degree + move)));
    });
    const motif = { rhythm, shape };
    if (tunes.size > 50) tunes.clear();
    tunes.set(part, motif);
    return motif;
  };

  /** How far each bar of a phrase lifts the motif: it peaks in the third */
  const LIFT = [0, 0, 2, 0];

  /**
   * The note the tune plays on a step, if any. Each phrase is the motif twice,
   * then once a step higher, then its first half coming home to the key note
   */
  const melodyAt = (step: number) => {
    const { tune } = sectionAt(step);
    if (!tune) return null;
    const { rhythm, shape } = tuneAt(step);
    const bar = barOf(step);
    const at = wrap(step, BAR);
    const i = rhythm.indexOf(at);
    if (i < 0) return null;
    const size = currentScale().length;
    /** The key note, an octave above the bass's, and one more in a chorus */
    const home = size * tune;
    const half = Math.ceil(rhythm.length / 2);
    if (bar === PHRASE - 1 && i >= half) {
      return i === half ? { degree: home, steps: BAR - at } : null;
    }
    let degree = home + shape[i] + LIFT[bar];
    // On the beat it lands on a note of the chord
    if (at % 4 === 0) {
      const tones = chordTones(chordAt(step)).map((tone) => wrap(tone, size));
      const shift = [0, -1, 1, -2, 2].find((shift) =>
        tones.includes(wrap(degree + shift, size)),
      );
      degree += shift ?? 0;
    }
    return { degree, steps: (rhythm[i + 1] ?? BAR) - at };
  };

  /** The bass's bar in sixteenths: the chord's root (0), its fifth (1), the root an octave up (2), or a rest */
  const GROOVE = [0, , , , , , 0, , 1, , , , 2, , 1, ,];
  const bassAt = (step: number) =>
    sectionAt(step).bass ? (GROOVE[wrap(step, BAR)] ?? null) : null;

  /**
   * The pulse: a kick on the first and third beats, and on the push before the
   * third while the Milky Way is on the meridian. The hi-hat is the stars: one
   * on every eighth note where a faint star crosses, and a ghost note between
   * them when a brighter one does
   */
  const drumsAt = (step: number) => {
    const { pulse } = sectionAt(step);
    if (!pulse) return { kick: false, hat: undefined };
    const at = wrap(step, BAR);
    const kick =
      at === 0 || at === 8 || (at === 6 && glowAt(step * GRID) > 0.3);
    const star = hitsAt(step).find(
      (hit) => hit.band === "dust" && !hit.line.west,
    )?.star;
    const hat =
      pulse > 1 && star && (at % 2 === 0 || star[2] <= CLEAR)
        ? star
        : undefined;
    return { kick, hat };
  };

  /** Beats are stressed, the sixteenths between them light */
  const stressAt = (step: number) =>
    wrap(step, 4) === 0 ? 1.2 : wrap(step, 2) === 0 ? 0.9 : 0.6;

  // Sound
  let audio: AudioContext | undefined;
  /** Where each instrument goes in */
  let outs: Record<Band, GainNode>;
  /** The tune and the glints: they step back while a bell rings */
  let under: GainNode;
  let delay: DelayNode;
  /** Half a second of hiss, for the hi-hat */
  let noise: AudioBuffer;
  /** What each control drives */
  let dials: Record<string, AudioParam> = {};

  /** The echo answers half a beat later, whatever the tempo */
  const echoGap = () => Math.min(1, 30 / knob("tempo"));

  const wake = () => {
    audio = new AudioContext();
    const bus = audio.createGain();
    const limiter = audio.createDynamicsCompressor();
    delay = audio.createDelay(1);
    const damp = audio.createBiquadFilter();
    const again = audio.createGain();
    const wet = audio.createGain();
    under = audio.createGain();
    outs = {
      bells: audio.createGain(),
      stars: audio.createGain(),
      dust: audio.createGain(),
      drums: audio.createGain(),
      bass: audio.createGain(),
    };
    outs.bells.connect(bus);
    outs.stars.connect(under);
    outs.dust.connect(under);
    under.connect(bus);
    // The bass and drums stay out of the echo, which would blur them
    outs.bass.connect(limiter);
    outs.drums.connect(limiter);
    noise = audio.createBuffer(1, audio.sampleRate / 2, audio.sampleRate);
    noise.getChannelData(0).forEach((_, i, data) => {
      data[i] = Math.random() * 2 - 1;
    });
    bus.connect(limiter);
    bus.connect(delay).connect(damp).connect(again).connect(delay);
    damp.connect(wet).connect(limiter);
    // Volume comes last, so it reaches the bass too
    const master = audio.createGain();
    limiter.connect(master).connect(audio.destination);
    dials = {
      volume: master.gain,
      echo: wet.gain,
      repeats: again.gain,
      tone: damp.frequency,
      bells: outs.bells.gain,
      stars: outs.stars.gain,
      dust: outs.dust.gain,
      drums: outs.drums.gain,
      bass: outs.bass.gain,
    };
    for (const name in dials) dials[name].value = knob(name);
    delay.delayTime.value = echoGap();
  };

  const tune = () => {
    for (const input of Object.values(knobs)) {
      const shown = input.nextElementSibling;
      if (shown) shown.textContent = input.value;
    }
    if (!audio) return;
    const at = audio.currentTime;
    for (const name in dials) dials[name].setTargetAtTime(knob(name), at, 0.05);
    delay.delayTime.setTargetAtTime(echoGap(), at, 0.05);
  };
  main.addEventListener("input", (event) => {
    const { name } = event.target as HTMLInputElement;
    if (name === "line") draft();
    if (name === "scale") forget();
    tune();
  });
  presets.addEventListener("change", () => {
    const values = JSON.parse(presets.value);
    for (const input of Object.values(knobs)) {
      input.value = values[input.name] ?? input.defaultValue;
    }
    draft();
    tune();
  });

  /** A voice that starts and stops on its own */
  const voice = (
    type: OscillatorType,
    frequency: number,
    at: number,
    ends: number,
  ) => {
    const voice = audio!.createOscillator();
    voice.type = type;
    voice.frequency.value = frequency;
    voice.start(at);
    voice.stop(at + ends + 0.05);
    return voice;
  };
  /** A struck note's loudness: a quick rise, then a long fall into an instrument */
  const strike = (
    band: Band,
    at: number,
    peak: number,
    rise: number,
    ends: number,
  ) => {
    const loudness = audio!.createGain();
    loudness.gain.setValueAtTime(0, at);
    loudness.gain.linearRampToValueAtTime(peak, at + rise);
    loudness.gain.exponentialRampToValueAtTime(0.0001, at + ends);
    loudness.connect(outs[band]);
    return loudness;
  };
  /** A magnitude is a factor of about 2.5 in light; the ear gets a gentler curve */
  const loudness = (star: Star) =>
    Math.min(0.9, 0.5 * 10 ** (-0.256 * star[2]));

  /** A bell: its star's own chord note, with the overtones of a struck bar */
  const ring = ({ star, line }: Hit, at: number) => {
    const interval = CROSS[names.get(star) ?? ""];
    const pitch = 220 * 2 ** ((interval ?? pitchClass(bellDegree(star))) / 12);
    const level = Math.max(0.4, loudness(star)) * line.gain;
    const length = 3 * knob("length");
    for (const [ratio, share, last] of [
      [0.5, 0.6, 1],
      [1, 1, 1],
      [2, 0.3, 0.7],
      [3, 0.18, 0.5],
      [4.2, 0.07, 0.25],
    ]) {
      voice("sine", pitch * ratio, at, length * last).connect(
        strike("bells", at, level * share, 0.006, length * last),
      );
    }
    // The rest of the sky steps back, then returns as the bell fades
    under.gain.cancelScheduledValues(at);
    under.gain.setTargetAtTime(0.65, at, 0.03);
    under.gain.setTargetAtTime(1, at + 0.3, 0.5);
  };

  /** A glint: a short high note of the chord, chosen by how high its star crosses */
  const glint = ({ star, line }: Hit, step: number, at: number) => {
    const tones = chordTones(chordAt(step));
    const tone = tones[Math.min(2, Math.floor(heightOf(star) * 3))];
    // Cool red stars sound rounder
    const warm = colorClass(star[3]) === 2;
    voice(
      warm ? "triangle" : "sine",
      880 * 2 ** (pitchClass(tone) / 12),
      at,
      0.2,
    ).connect(
      strike(
        "dust",
        at,
        loudness(star) * 0.5 * line.gain * stressAt(step),
        0.004,
        0.18,
      ),
    );
  };

  /** The tune's voice: a soft electric piano, one tone bending another */
  const sing = (degree: number, steps: number, step: number, at: number) => {
    const pitch = 220 * 2 ** (semitones(degree) / 12);
    const seconds = (steps * 60) / knob("tempo") / 4;
    const ends = Math.max(0.3, seconds * 1.2) * knob("length");
    const body = voice("sine", pitch, at, ends);
    const bend = voice("sine", pitch, at, ends);
    const depth = audio!.createGain();
    // The overtone control sets how bright the attack is
    depth.gain.setValueAtTime(pitch * (0.5 + 3 * knob("shimmer")), at);
    depth.gain.exponentialRampToValueAtTime(pitch * 0.05, at + 0.5);
    bend.connect(depth).connect(body.frequency);
    body.connect(strike("stars", at, 0.22 * stressAt(step), 0.005, ends));
  };

  // The bass has three sources: it plays the chord the bells and the
  // progression set, on a beat of sidereal minutes, and opens up in the Milky Way
  const pluck = (part: number, step: number, at: number) => {
    const root = chordAt(step);
    const above = [0, semitones(root + 4) - semitones(root), 12][part];
    const pitch = 55 * 2 ** ((pitchClass(root) + above) / 12);
    const out = strike("bass", at, 0.8, 0.008, 0.5);
    voice("sine", pitch, at, 0.5).connect(out);
    const edge = audio!.createBiquadFilter();
    edge.frequency.value = 200 + 2500 * glowAt(step * GRID);
    edge.Q.value = 2;
    const share = audio!.createGain();
    share.gain.value = 0.5;
    voice("sawtooth", pitch, at, 0.5).connect(edge).connect(share).connect(out);
  };

  /** A pad holding the bar's chord under everything, with the bells */
  const hold = (step: number, at: number) => {
    const bar = (4 * 60) / knob("tempo");
    const ends = bar + 0.4;
    for (const tone of chordTones(chordAt(step))) {
      const pitch = 110 * 2 ** (pitchClass(tone) / 12);
      const soft = audio!.createBiquadFilter();
      soft.frequency.value = 800;
      const level = audio!.createGain();
      level.gain.setValueAtTime(0, at);
      level.gain.linearRampToValueAtTime(0.03, at + 0.6);
      level.gain.setValueAtTime(0.03, at + bar - 0.2);
      level.gain.linearRampToValueAtTime(0, at + ends);
      soft.connect(level).connect(outs.bells);
      for (const detune of [-7, 7]) {
        const each = voice("sawtooth", pitch, at, ends);
        each.detune.value = detune;
        each.connect(soft);
      }
    }
  };

  /** A kick: a low tone that drops as it fades */
  const thump = (at: number) => {
    const body = voice("sine", 110, at, 0.35);
    body.frequency.setValueAtTime(110, at);
    body.frequency.exponentialRampToValueAtTime(42, at + 0.12);
    body.connect(strike("drums", at, 0.9, 0.002, 0.35));
  };

  /** A hi-hat: a short hiss, louder for a brighter star */
  const tick = (star: Star, step: number, at: number) => {
    const hiss = audio!.createBufferSource();
    hiss.buffer = noise;
    const thin = audio!.createBiquadFilter();
    thin.type = "highpass";
    thin.frequency.value = 7000;
    hiss
      .connect(thin)
      .connect(
        strike(
          "drums",
          at,
          (0.1 + loudness(star) * 0.3) * stressAt(step),
          0.001,
          0.05,
        ),
      );
    hiss.start(at, Math.random() * 0.4, 0.08);
  };

  /** Sounds one step of the grid at the given time on the audio clock */
  const schedule = (step: number, at: number) => {
    for (const hit of hitsAt(step)) {
      if (hit.band === "bells") ring(hit, at);
      else glint(hit, step, at);
    }
    const note = melodyAt(step);
    if (note) sing(note.degree, note.steps, step, at);
    const part = bassAt(step);
    if (part !== null) pluck(part, step, at);
    if (wrap(step, BAR) === 0) hold(step, at);
    const { kick, hat } = drumsAt(step);
    if (kick) thump(at);
    if (hat) tick(hat, step, at);
  };

  // Each note leaves a ring where it sounds
  type Ring = {
    x: number;
    y: number;
    born: number;
    size: number;
    color: string;
    bold: boolean;
  };
  let rings: Ring[] = [];
  /** The type the names are set in */
  const NAME_FONT = 'italic 15px "STIX Two Text", serif';
  /** How far past its line, in degrees, a star keeps its name */
  const TRAIL = 12;
  /** Names that follow their stars away from the line they crossed */
  type Label = { name: string; star: Star; west: number; born: number };
  let labels: Label[] = [];
  /** Degrees a named star has turned since it crossed its line */
  const past = (label: Label) =>
    wrap(time - label.star[0] - label.west + 180) - 180;
  /** When a named star last took the readout */
  let named = -Infinity;

  /** Where on the meridian a note of the tune shows, from 0 at the pole to 1 at the top */
  const heightOfNote = (degree: number) => {
    const size = currentScale().length;
    return Math.max(0, Math.min(1, (degree - size + 4) / (size + 6)));
  };

  const asHours = (ra: number) => {
    const minutes = Math.round((ra / 15) * 60) % 1440;
    return `${String(Math.floor(minutes / 60)).padStart(2, "0")}h ${String(minutes % 60).padStart(2, "0")}m`;
  };
  const asDegrees = (dec: number) => {
    const minutes = Math.round(Math.abs(dec) * 60);
    return `${dec < 0 ? "−" : "+"}${Math.floor(minutes / 60)}° ${String(minutes % 60).padStart(2, "0")}′`;
  };

  /** Shows one step of the grid on the sky, as it sounds */
  const show = (step: number, now: number) => {
    const hits = hitsAt(step);
    for (const { star, line, band } of hits) {
      rings.push({
        ...along(line.west, 90 + star[1]),
        born: now,
        size: band === "bells" ? 46 : Math.max(3, 16 - star[2] * 2.2),
        color: COLORS[colorClass(star[3])][1],
        bold: band === "bells",
      });
      const name = names.get(star);
      // Two names on the same spot would be unreadable: the first one stays.
      // A name moves off with its star, so it is compared where it is now
      if (!name) continue;
      const spot = along(line.west, 90 + star[1]);
      pen.font = NAME_FONT;
      const width = (text: string) => pen.measureText(text).width + 8;
      const taken = labels.some((label) => {
        const there = along(past(label) + label.west, 90 + label.star[1]);
        return (
          Math.abs(there.y - spot.y) < 16 &&
          there.x < spot.x + width(name) &&
          spot.x < there.x + width(label.name)
        );
      });
      if (!taken) labels.push({ name, star, west: line.west, born: now });
    }
    // The tune is drawn from the stars but has none of its own: it sounds on
    // the meridian at its pitch, and the bass from the pole
    const note = melodyAt(step);
    if (note) {
      rings.push({
        ...along(0, span(0) * (0.15 + 0.75 * heightOfNote(note.degree))),
        born: now,
        size: 8 + note.steps * 2,
        color: TUNE,
        bold: true,
      });
    }
    const part = bassAt(step);
    if (part !== null) {
      rings.push({
        ...pole,
        born: now,
        size: 22 + part * 15,
        color: BASS,
        bold: false,
      });
    }
    // A named star stays in the readout until the next one
    const first = hits.filter((hit) => hit.line.west === 0);
    const told = (first.find((hit) => hit.band === "bells") ?? first[0])?.star;
    const name = told && names.get(told);
    if (told && (name || now - named > 6000)) {
      if (name) named = now;
      readout.textContent = `${name ? `${name}, ` : ""}α ${asHours(told[0])}, δ ${asDegrees(told[1])}, mag ${told[2].toFixed(1)}`;
    }
  };

  /** Steps of the grid a roll shows ahead of now: two bars */
  const WINDOW = 32;
  /** What each roll draws its notes in */
  const INKS: Record<Band, string> = {
    bells: PALE,
    stars: TUNE,
    dust: RULE,
    drums: PALE,
    bass: BASS,
  };

  const drawRoll = ({ key, pen, width, height }: (typeof rolls)[number]) => {
    const current = time / GRID;
    const lead = width * 0.14;
    const cell = (width - lead) / WINDOW;
    /** From 0 at the bottom of the roll to 1 at the top */
    const rise = (share: number) => height - 4 - share * (height - 8);
    pen.clearRect(0, 0, width, height);
    // Beats along the bottom, bars from top to bottom
    pen.fillStyle = RULE;
    pen.globalAlpha = 0.14;
    for (let i = Math.ceil(current); i < current + WINDOW; i++) {
      if (i % 4 === 0) {
        const top = i % BAR ? height - 4 : 0;
        pen.fillRect(lead + (i - current) * cell, top, 1, height);
      }
    }
    pen.fillStyle = INKS[key];
    for (let i = Math.floor(current) - 4; i < current + WINDOW; i++) {
      const x = lead + (i - current) * cell;
      // What has sounded fades out behind the playhead
      const gone = current - i;
      const alpha = gone > 0 ? Math.max(0, 1 - gone / 4) : 0.7;
      if (key === "bass") {
        const part = bassAt(i);
        if (part === null) continue;
        pen.globalAlpha = alpha * (0.45 + 0.55 * glowAt(i * GRID));
        pen.fillRect(x, rise(part / 2) - 1.5, cell * 1.5, 3);
      } else if (key === "drums") {
        // Kicks along the bottom, the hi-hat along the top
        const { kick, hat } = drumsAt(i);
        pen.globalAlpha = alpha;
        if (kick) pen.fillRect(x, rise(0.1) - 3, 2, 6);
        if (hat) {
          pen.globalAlpha = alpha * (0.4 + loudness(hat));
          pen.fillRect(x, rise(0.85) - 1, 1.5, 3);
        }
      } else if (key === "stars") {
        const note = melodyAt(i);
        if (!note) continue;
        pen.globalAlpha = alpha;
        pen.fillRect(
          x,
          rise(heightOfNote(note.degree)) - 1.5,
          cell * note.steps - 1,
          3,
        );
      } else {
        for (const { star, line, band } of hitsAt(i)) {
          if (band !== key) continue;
          pen.globalAlpha = alpha * line.gain;
          pen.beginPath();
          pen.arc(x, rise(heightOf(star)), band === "bells" ? 3.5 : 1.2, 0, 7);
          pen.fill();
        }
      }
    }
    pen.fillStyle = RULE;
    pen.globalAlpha = 0.55;
    pen.fillRect(lead, 0, 1, height);

    if (key === "stars") {
      // Which section is playing, and what comes next when it is close
      const step = Math.floor(current);
      const next = sectionAt(step + BAR * 2);
      const name = sectionAt(step).name;
      pen.font = 'italic 12px "STIX Two Text", serif';
      pen.textAlign = "right";
      pen.fillStyle = PALE;
      pen.globalAlpha = 0.65;
      pen.fillText(
        next.name === name ? name : `${name}, then ${next.name.toLowerCase()}`,
        width - 6,
        12,
      );
    }
    if (key === "bells") {
      // The next bell is often many bars away: say which, and how far
      const limit = span(0) - 90;
      let next: [bars: number, name: string] | undefined;
      for (const [star, name] of names) {
        const bars = wrap(star[0] - time) / BEAT / 4;
        if (star[1] <= limit && (!next || bars < next[0])) next = [bars, name];
      }
      if (next && next[0] > 1) {
        pen.font = 'italic 12px "STIX Two Text", serif';
        pen.textAlign = "right";
        pen.fillStyle = PALE;
        pen.globalAlpha = 0.65;
        pen.fillText(
          `${next[1]} in ${Math.round(next[0])} bars`,
          width - 6,
          height / 2 + 4,
        );
      }
    }
    pen.globalAlpha = 1;
  };

  const drawStage = (now: number) => {
    pen.clearRect(0, 0, stage.width, stage.height);
    pen.lineWidth = 1;
    pen.strokeStyle = RULE;
    for (const { west, gain } of lines) {
      const end = along(west, span(west));
      pen.globalAlpha = 0.3 * gain;
      pen.beginPath();
      pen.moveTo(pole.x, pole.y);
      pen.lineTo(end.x, end.y);
      pen.stroke();
    }
    // A name goes once its star is well past its line, or when the sky has
    // jumped on, as it does after a while in a background tab
    labels = labels.filter((label) => past(label) > -1 && past(label) < TRAIL);
    pen.font = NAME_FONT;
    pen.fillStyle = PALE;
    for (const label of labels) {
      const turned = past(label);
      const { x, y } = along(turned + label.west, 90 + label.star[1]);
      pen.globalAlpha =
        0.9 * Math.min(1, (now - label.born) / 500, (1 - turned / TRAIL) * 3);
      pen.fillText(label.name, x + 12, y + 5);
    }
    rings = rings.filter((ring) => now - ring.born < 1800);
    for (const ring of rings) {
      const age = (now - ring.born) / 1800;
      pen.lineWidth = ring.bold ? 2 : 1;
      pen.strokeStyle = ring.color;
      pen.globalAlpha = 0.7 * (1 - age) ** 2;
      pen.beginPath();
      pen.arc(
        ring.x,
        ring.y,
        1.5 + ring.size * (calm ? 0.4 : age ** 0.5),
        0,
        7,
      );
      pen.stroke();
    }
    pen.globalAlpha = 1;
  };

  /** The real sky's sidereal time, counted on without wrapping from when the page opened */
  const opened = { time: siderealTime(new Date()), at: Date.now() };
  const realTime = () => opened.time + ((Date.now() - opened.at) / 1000) * REAL;
  /** How far listening has run the page's sky ahead of the real one */
  let ahead = 0;
  let time = opened.time;
  let speed = REAL;
  let listening = false;
  /** The last step of the grid sent to the audio clock, a little ahead of the sky */
  let played = Math.floor(time / GRID);
  /** The last step shown on the sky */
  let shown = played;
  origin = Math.floor(played / BAR) * BAR;
  let last = performance.now();
  /** When the canvases were last drawn, and the chart's angle as last written */
  let drawn = 0;
  let written = "";
  /** A quick turn of the sky to where the song starts, when there is one under way */
  let travel: { from: number; to: number; start: number } | undefined;
  /** How long that turn takes, in milliseconds */
  const TRAVEL = 3000;

  /**
   * Where the song starts: now, if the Milky Way is on the meridian or near,
   * and otherwise a little before it rises there, at Orion, so the bright
   * stars and the galaxy arrive within the first sections
   */
  const startAt = () => {
    const near = (ra: number) => glowAt(ra) >= 0.2;
    for (let turn = 0; turn < 360; turn += 2) {
      if (near(time + turn)) {
        return turn <= 24 ? time : time + turn - 20;
      }
    }
    return time;
  };

  const frame = (now: number) => {
    const elapsed = Math.min(0.1, (now - last) / 1000);
    last = now;
    if (travel) {
      // The turn eases in and out, and nothing sounds or rings on the way
      const k = calm ? 1 : Math.min(1, (now - travel.start) / TRAVEL);
      const ease = k < 0.5 ? 4 * k ** 3 : 1 - (-2 * k + 2) ** 3 / 2;
      time = travel.from + (travel.to - travel.from) * ease;
      ahead = time - realTime();
      played = shown = Math.floor(time / GRID);
      if (k === 1) {
        travel = undefined;
        origin = (Math.floor(played / BAR) + 1) * BAR;
        forget();
      }
    } else if (listening) {
      time += speed * elapsed;
      ahead = time - realTime();
    } else {
      // Silent, it keeps to the clock, even after a while in a background tab
      time = realTime() + ahead;
    }
    // The sky keeps its real pace until someone listens: then a beat is a sidereal minute
    const rest = listening && !travel ? (knob("tempo") / 60) * BEAT : REAL;
    speed = rest + (speed - rest) * Math.exp(-elapsed / 1.5);
    const angle = `${(time - UP).toFixed(3)}deg`;
    if (angle !== written) chart.style.rotate = written = angle;

    // Sound is scheduled a little ahead, to fall exactly on the grid
    const due = Math.floor((time + speed * AHEAD) / GRID);
    // After a pause, such as a hidden tab, there is no catching up
    if (due - played > 16) played = due - 1;
    while (played < due) {
      played++;
      if (audio?.state === "running") {
        const wait = Math.max(0, (played * GRID - time) / speed);
        schedule(played, audio.currentTime + wait);
      }
    }
    const here = Math.floor(time / GRID);
    if (here - shown > 16) shown = here - 1;
    while (shown < here) show(++shown, now);

    // A sky at its real pace barely moves: with nothing fading, it is drawn twice a second
    const still = !listening && !rings.length && !labels.length;
    if (!still || now - drawn > 500) {
      drawn = now;
      drawStage(now);
      rolls.forEach(drawRoll);
    }
    requestAnimationFrame(frame);
  };

  measure();
  addEventListener("resize", measure);
  requestAnimationFrame(frame);

  const listen = async (on: boolean) => {
    if (on && !audio) {
      wake();
      const to = startAt();
      if (to === time) {
        origin = (Math.floor(played / BAR) + 1) * BAR;
        forget();
      } else {
        travel = { from: time, to, start: performance.now() };
      }
    }
    listening = on;
    await (on ? audio?.resume() : audio?.suspend());
    button.ariaPressed = String(on);
    button.textContent = on ? "Mute" : "Listen";
  };
  button.addEventListener("click", () => listen(button.ariaPressed !== "true"));
</script>
